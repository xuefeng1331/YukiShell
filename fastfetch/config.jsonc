{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/hiyuki/.config/fastfetch/Hiyuki funny.jpg",
        "type": "auto",
        "width": 30,
        "height": 15,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;203;166;247", "title": "38;2;245;194;231" }
    },
    "modules": [
        {
            "key": "{#38;2;108;112;134}╭─────────────╮",
            "type": "custom"
        },
        {
            "key": "{#38;2;108;112;134}│ {#38;2;203;166;247} user      {#38;2;108;112;134}│",
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
        },
        {
            "key": "{#38;2;108;112;134}│ {#38;2;148;226;213} distro    {#38;2;108;112;134}│",
            "type": "os"
        },
        {
            "key": "{#38;2;108;112;134}│ {#38;2;245;194;231} kernel    {#38;2;108;112;134}│",
            "type": "kernel"
        },
        {
            "key": "{#38;2;108;112;134}│ {#38;2;249;226;175}󰅐 uptime    {#38;2;108;112;134}│",
            "type": "uptime"
        },
        {
            "key": "{#38;2;108;112;134}│ {#38;2;166;227;161} monitor   {#38;2;108;112;134}│",
            "type": "monitor",
            "format": "{name} {width}x{height}@{refresh-rate}"
        },
        {
            "key": "{#38;2;108;112;134}│ {#38;2;203;166;247} wm        {#38;2;108;112;134}│",
            "type": "wm"
        },
        {
