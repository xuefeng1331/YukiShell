        },
        {
            "key": "{#38;2;108;112;134}│ {#38;2;203;166;247} cpu       {#38;2;108;112;134}│",
            "type": "cpu",
            "format": "Intel(R) Core i3-12100F ({3}C/{4}T) @ {7}"
        },
        {
            "key": "{#38;2;108;112;134}│ {#38;2;245;194;231}󰾲 gpu       {#38;2;108;112;134}│",
            "type": "gpu",
