{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo.png",
        "type": "auto",
        "width": 30,
        "height": 15,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;203;166;247", "title": "38;2;245;194;231" }
    },
    "modules": [
        {
            "key": "{#38;2;238;172;190}╭─────────────╮",
            "type": "custom"
        },
        {
            "key": "{#38;2;238;172;190}│ {#38;2;137;180;250} user      {#38;2;238;172;190}│",
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
        },
        {
            "key": "{#38;2;238;172;190}│ {#38;2;145;179;245} distro    {#38;2;238;172;190}│",
            "type": "os"
        },
        {
            "key": "{#38;2;238;172;190}│ {#38;2;154;179;240} kernel    {#38;2;238;172;190}│",
            "type": "kernel"
        },
        {
            "key": "{#38;2;238;172;190}│ {#38;2;162;178;235}󰅐 uptime    {#38;2;238;172;190}│",
            "type": "uptime"
        },
        {
            "key": "{#38;2;238;172;190}│ {#38;2;171;177;230} monitor   {#38;2;238;172;190}│",
            "type": "monitor",
            "format": "{name} {width}x{height}@{refresh-rate}"
        },
        {
            "key": "{#38;2;238;172;190}│ {#38;2;179;177;225} wm        {#38;2;238;172;190}│",
            "type": "wm"
        },
        {
            "key": "{#38;2;238;172;190}│ {#38;2;188;176;220}𝄜 board     {#38;2;238;172;190}│",
            "type": "board"
        },
        {
            "key": "{#38;2;238;172;190}│ {#38;2;196;175;215} cpu       {#38;2;238;172;190}│",
            "type": "cpu",
            "format": "Intel(R) Core i3-12100F ({3}C/{4}T) @ {7}"
        },
        {
            "key": "{#38;2;238;172;190}│ {#38;2;204;175;210}󰾲 gpu       {#38;2;238;172;190}│",
            "type": "gpu",
            "hideType": "integrated"
        },
        {
            "key": "{#38;2;238;172;190}│ {#38;2;213;174;205} memory    {#38;2;238;172;190}│",
            "type": "memory"
        },
        {
            "key": "{#38;2;238;172;190}│ {#38;2;221;173;200}󰓡 swap      {#38;2;238;172;190}│",
            "type": "swap"
        },
        {
            "key": "{#38;2;238;172;190}│ {#38;2;230;173;195} disk      {#38;2;238;172;190}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "{#38;2;238;172;190}├─────────────┤",
            "type": "custom"
        },
        {
            "key": "{#38;2;238;172;190}│ {#38;2;238;172;190} colors    {#38;2;238;172;190}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "{#38;2;238;172;190}╰─────────────╯",
            "type": "custom"
        }
    ]
}
