#!/bin/sh
cd "$(dirname "$0")/.." || exit 1
fail=0
have() { command -v "$1" >/dev/null 2>&1; }
section() { printf '%s ' "$1"; }
ok()   { echo "ok"; }
bad()  { echo "FAILED"; fail=1; [ -n "$1" ] && printf '%s\n' "$1" | sed 's/^/    /'; }
skip() { echo "skipped ($1 not installed)"; }

section "lua    "; if have luac; then out=$(for f in $(git ls-files '*.lua'); do luac -p "$f" 2>&1 | sed "s|^|$f: |"; done); [ -z "$out" ] && ok || bad "$out"; else skip luac; fi
section "fish   "; if have fish; then out=$(for f in $(git ls-files '*.fish'); do fish -n "$f" 2>&1 | head -3 | sed "s|^|$f: |"; done); [ -z "$out" ] && ok || bad "$out"; else skip fish; fi
section "shell  "; out=$(for f in $(git ls-files | xargs grep -lE '^#!.*(sh|bash)$' 2>/dev/null); do
    case "$(head -n1 "$f")" in *bash*) bash -n "$f" 2>&1 ;; *) sh -n "$f" 2>&1 ;; esac | sed "s|^|$f: |"; done); [ -z "$out" ] && ok || bad "$out"
section "python "; if have python3; then out=$(for f in $(git ls-files '*.py'); do python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" "$f" 2>&1 | tail -1 | sed "s|^|$f: |"; done); [ -z "$out" ] && ok || bad "$out"; else skip python3; fi
section "json   "; if have python3; then out=$(for f in $(git ls-files '*.json'); do python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$f" 2>&1 | tail -1 | sed "s|^|$f: |"; done); [ -z "$out" ] && ok || bad "$out"; else skip python3; fi
section "js     "; if have node; then out=$(for f in $(git ls-files '*.js'); do
    sed -e 's/^\.pragma.*//' -e 's/^\.import.*//' "$f" | node -e 'let t="";process.stdin.on("data",d=>t+=d).on("end",()=>{try{new Function(t)}catch(e){console.log(e.message);process.exit(1)}})' 2>&1 | head -2 | sed "s|^|$f: |"; done); [ -z "$out" ] && ok || bad "$out"; else skip node; fi
section "qml    "
# Qt 6's qmllint first: a "qmllint" on PATH can be Qt 5's, which prints nothing at all for Qt 6 files (a broken file passed as "ok")
qlint=$(ls /usr/lib/qt6/bin/qmllint 2>/dev/null || command -v qmllint6 || command -v qmllint)
if [ -n "$qlint" ]; then
    out=$(for f in $(git ls-files '*.qml'); do "$qlint" "$f" 2>&1 | grep -E "\[syntax\]|Syntax|syntax\.|duplicate-ids|Error:" | grep -v "onShaderError" | head -3; done)
    # a handler / property set twice on one object: qmllint lets it through, Qt then refuses to load the whole file
    have python3 && out="$out$(python3 tools/qml-dupes.py $(git ls-files '*.qml') 2>&1)"
    [ -z "$out" ] && ok || bad "$out"
else skip qmllint; fi
section "i18n   "; if have python3; then out=$(python3 tools/i18n-check.py 2>&1); if [ $? -eq 0 ]; then ok; else bad "$(printf '%s\n' "$out" | head -12)"; fi; else skip python3; fi
exit $fail
