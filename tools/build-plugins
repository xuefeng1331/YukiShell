#!/bin/sh
set -e
here=$(cd "$(dirname "$0")/.." && pwd)
dest="${XDG_DATA_HOME:-$HOME/.local/share}/yukishell/qml"
build="${XDG_CACHE_HOME:-$HOME/.cache}/yukishell/build/yukivideo"
command -v cmake >/dev/null 2>&1 || { echo "build-plugins: cmake not found, skipped" >&2; exit 1; }
cmake -S "$here/shell/plugins/yukivideo" -B "$build" -DCMAKE_BUILD_TYPE=Release >/dev/null
cmake --build "$build" -j"$(nproc 2>/dev/null || echo 4)" >/dev/null
mkdir -p "$dest/YukiVideo"
cp -f "$build/YukiVideo/qmldir" "$build/YukiVideo/yukivideo.qmltypes" "$dest/YukiVideo/"
cp -f "$build/YukiVideo/libyukivideo.so" "$dest/YukiVideo/.libyukivideo.so.new"
mv -f "$dest/YukiVideo/.libyukivideo.so.new" "$dest/YukiVideo/libyukivideo.so"
echo "build-plugins: YukiVideo installed in $dest (restart the shell: yuki-restart)"
