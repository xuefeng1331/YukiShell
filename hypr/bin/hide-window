#!/usr/bin/env python3
"""Hide windows one by one, and bring them all back, with one key (Super+Alt+S).

  hide-window          the toggle: a window is focused -> hide it (press again to hide the next one too);
                       no window focused (everything on this workspace is hidden, or it was empty), or the pointer resting on the
                       empty desktop while focus follows the mouse -> show ALL hidden windows
  hide-window hide     always hide the focused window (the menu bar's "Hide <app>")
  hide-window show     show all hidden windows (the menu bar's "Show Hidden Windows")

Hiding moves the window to the special workspace "hidden" and remembers where it was (its workspace, floating or tiled, position
and size, full screen); showing puts each one back exactly like that. The focus goes to the window hidden last that comes back
onto the workspace you are looking at, so showing never throws you onto another workspace.

The remembered windows live in $XDG_RUNTIME_DIR/yukishell-hidden.json (oldest first). A window that was closed while hidden is
dropped from it. Windows that were put in "hidden" some other way (no record) come back to the current workspace."""
import json, os, subprocess, sys

STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "yukishell-hidden.json")
HIDDEN = "special:hidden"

def hc(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout

def hj(what):
    try:
        return json.loads(hc("-j", what))
    except ValueError:
        return {} if what == "activewindow" else []

def dispatch(lua):
    hc("dispatch", lua)

def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return []

def save(entries):
    with open(STATE, "w") as f:
        json.dump(entries, f)

def lua_str(s):
    return json.dumps(str(s))

def ws_selector(ws):
    return str(ws["id"]) if isinstance(ws.get("id"), int) and ws["id"] > 0 else lua_str(ws.get("name", ""))

def restore(entry, focus):
    sel = f'window = "address:{entry["address"]}"'
    dispatch(f"hl.dsp.window.move({{ workspace = {entry['workspace']}, follow = false, {sel} }})")
    if entry.get("floating"):
        dispatch(f'hl.dsp.window.float({{ action = "enable", {sel} }})')
        w, h = entry["size"]
        x, y = entry["at"]
        dispatch(f"hl.dsp.window.resize({{ x = {w}, y = {h}, {sel} }})")
        dispatch(f"hl.dsp.window.move({{ x = {x}, y = {y}, {sel} }})")
    elif entry.get("floating") is False:
        dispatch(f'hl.dsp.window.float({{ action = "disable", {sel} }})')
    fs = entry.get("fullscreen", 0)
    if fs or focus:
        dispatch(f"hl.dsp.focus({{ {sel} }})")
    if fs:
        dispatch(f'hl.dsp.window.fullscreen({{ mode = "{"maximized" if fs == 1 else "fullscreen"}", action = "set" }})')

def pointer_on_desktop():
    """With focus following the mouse, Hyprland keeps the keyboard focus on the last window when the pointer moves onto the empty
    desktop (it only ever moves focus INTO a window). The pointer resting on the desktop, over no window, therefore counts as
    "nothing focused" here."""
    try:
        if int(json.loads(hc("getoption", "input:follow_mouse", "-j") or "{}").get("int", 1)) == 0:
            return False
        cx, cy = (float(v) for v in hc("cursorpos").replace(" ", "").split(","))
    except (ValueError, TypeError):
        return False
    shown = set()
    for m in hj("monitors"):
        shown.add(m.get("activeWorkspace", {}).get("id"))
        if m.get("specialWorkspace", {}).get("id"):
            shown.add(m["specialWorkspace"]["id"])
    for c in hj("clients"):
        if not c.get("mapped") or c.get("hidden") or c.get("workspace", {}).get("id") not in shown:
            continue
        (x, y), (w, h) = c.get("at", [0, 0]), c.get("size", [0, 0])
        if x <= cx < x + w and y <= cy < y + h:
            return False
    return True

def focused_window():
    """The focused window, if it is a normal one (not on a special workspace such as "hidden" itself)."""
    win = hj("activewindow")
    if not isinstance(win, dict) or not win.get("address"):
        return None
    if win.get("workspace", {}).get("name", "").startswith("special:"):
        return None
    return win

def hide(win, entries):
    addr = win["address"]
    entry = {
        "address": addr,
        "workspace": ws_selector(win["workspace"]),
        "floating": bool(win.get("floating")),
        "at": win.get("at", [0, 0]),
        "size": win.get("size", [0, 0]),
        "fullscreen": int(win.get("fullscreen", 0) or 0),
    }
    sel = f'window = "address:{addr}"'
    if entry["fullscreen"]:
        dispatch(f'hl.dsp.window.fullscreen({{ mode = "{"maximized" if entry["fullscreen"] == 1 else "fullscreen"}", action = "unset" }})')
    dispatch(f'hl.dsp.window.move({{ workspace = "{HIDDEN}", follow = false, {sel} }})')
    save([e for e in entries if e["address"] != addr] + [entry])

def show_all(entries, in_hidden, clients):
    active = hj("activeworkspace")
    here = ws_selector(active) if isinstance(active, dict) and active else None
    recorded = {e["address"] for e in entries}
    stray = sorted((a for a in in_hidden if a not in recorded), key=lambda a: -clients[a].get("focusHistoryID", 0))
    todo = [{"address": a, "workspace": here} for a in stray if here] + entries
    target = next((e["address"] for e in reversed(todo) if here is not None and str(e["workspace"]) == str(here)), None)
    save([])
    for e in todo:
        restore(e, False)
    if target:
        dispatch(f'hl.dsp.focus({{ window = "address:{target}" }})')

def main(mode):
    clients = {c["address"]: c for c in hj("clients")}
    in_hidden = {a for a, c in clients.items() if c.get("workspace", {}).get("name") == HIDDEN}
    entries = [e for e in load() if e.get("address") in in_hidden]
    save(entries)

    if mode in ("hide", "toggle"):
        win = None if (mode == "toggle" and pointer_on_desktop()) else focused_window()
        if win:
            hide(win, entries)
            return
        if mode == "hide":
            return
    show_all(entries, in_hidden, clients)

main(sys.argv[1] if len(sys.argv) > 1 else "toggle")
