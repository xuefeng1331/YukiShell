#!/usr/bin/env bash
count() { hyprctl -j clients | python3 -c 'import json,sys; print(sum(c["class"].startswith("dash-") for c in json.load(sys.stdin)))'; }

if [ "$(count)" -gt 0 ]; then
    hyprctl -j clients | python3 -c 'import json,sys; [print(c["address"]) for c in json.load(sys.stdin) if c["class"].startswith("dash-")]' |
        while read -r a; do hyprctl dispatch "hl.dsp.window.close({ window = \"address:$a\" })" >/dev/null; done
    exit 0
fi

open() {
    local n; n=$(count); local cls=$1; shift
    hyprctl dispatch "hl.dsp.exec_cmd([[kitty --class $cls $*]], { tile = true })" >/dev/null
    for _ in $(seq 40); do [ "$(count)" -gt "$n" ] && break; sleep 0.05; done
}
pre() { hyprctl dispatch "hl.dsp.layout(\"preselect $1\")" >/dev/null; }
open dash-cava  cava -p "$HOME/.config/cava/dashboard.conf"
pre u; open dash-fff   fish -C fff
pre r; open dash-clock tty-clock -scb -C 5
read -r fff w < <(hyprctl -j clients | python3 -c 'import json,sys; c=next(c for c in json.load(sys.stdin) if c["class"]=="dash-fff"); print(c["address"], c["size"][0])')
hyprctl dispatch "hl.dsp.window.resize({ x = $((1000 - w)), y = 0, relative = true, window = \"address:$fff\" })" >/dev/null
cava=$(hyprctl -j clients | python3 -c 'import json,sys; print(next(c["address"] for c in json.load(sys.stdin) if c["class"]=="dash-cava"))')
hyprctl dispatch "hl.dsp.window.resize({ x = 0, y = -100, relative = true, window = \"address:$cava\" })" >/dev/null
