#!/usr/bin/env python3
"""yukishell: YukiShell's command-line companion.

  yukishell stats                 what YukiShell uses right now: CPU, RAM, GPU, video memory, helpers, caches
  yukishell stats -i 5            sample for 5 seconds instead of 2 (steadier numbers)
  yukishell stats -w              keep refreshing (Ctrl+C to stop)
  yukishell stats --json          the same as JSON, for scripts
  yukishell sc                    snapshot clean-up (snapper): keep the newest few, delete the rest, after you confirm
  yukishell sc -n                 only show what would be deleted
  yukishell sc -k 6               keep the newest 6 instead of 4 (a "before" snapshot stays with its "after")
  yukishell sc --keep-id 387      also keep snapshot 387 (repeat it for more)
  yukishell sc --limit 10         and from now on let snapper keep at most 10 (its NUMBER_LIMIT)
  yukishell sc -y                 don't ask
  yukishell version               the installed YukiShell version
  yukishell help                  this text

CPU is "% of one CPU thread" (100 % = one thread fully busy, like top). RAM is PSS: shared libraries are split between the
processes that share them, so the numbers add up. GPU load and video memory come from nvidia-smi on NVIDIA cards and from the
kernel's per-process DRM statistics (fdinfo) on AMD / Intel.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time
import xml.etree.ElementTree as ET

HZ = os.sysconf("SC_CLK_TCK")
PAGE = os.sysconf("SC_PAGE_SIZE")
HOME = os.path.expanduser("~")
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "quickshell", "YukiShell")
CACHE = os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache"))

# helpers YukiShell starts, recognised when an earlier YukiShell left them behind (see reapOrphans in YukiBar.qml)
LEFTOVER_SIGS = [
    ("systemd-inhibit", "--who=yukibar", "Keep Awake inhibitor"),
    ("inotifywait", "%e|%w%f", "wallpaper folder watcher"),
    ("cava", "yukishell-cava.conf", "music visualizer"),
    ("wl-paste", ".cache/yukibar", "clipboard watcher"),
    ("python3", "assets/imwatch.py", "input method watcher"),
]
WALLPAPER_COMMS = {"mpvpaper": "animated wallpaper", "awww-daemon": "still wallpaper", "swww-daemon": "still wallpaper"}
HELPER_NAMES = {
    "cava": "music visualizer", "inotifywait": "wallpaper folder watcher", "wl-paste": "clipboard watcher",
    "systemd-inhibit": "Keep Awake", "sleep": "Keep Awake (holder)", "hyprsunset": "Night Shift", "gsettings": "colour scheme watcher",
    "setpriv": "helper wrapper", "wf-recorder": "screen recording", "pkttyagent": "Keep Awake (polkit agent)",
}


# ---------- /proc ----------
def read(path, mode="r"):
    try:
        with open(path, mode) as f:
            return f.read()
    except OSError:
        return None


def stat_of(pid, task=None):
    s = read(f"/proc/{pid}/task/{task}/stat" if task else f"/proc/{pid}/stat")
    if not s:
        return None
    head, _, rest = s.rpartition(")")
    f = rest.split()
    return {"comm": head.partition("(")[2], "ppid": int(f[1]), "ticks": int(f[11]) + int(f[12]),
            "threads": int(f[17]), "start": int(f[19])}


def argv_of(pid):
    raw = read(f"/proc/{pid}/cmdline", "rb")
    return [a.decode(errors="replace") for a in raw.split(b"\0") if a] if raw else []


def all_pids():
    return [int(d) for d in os.listdir("/proc") if d.isdigit()]


def memory_of(pid):
    m = {"pss": 0, "rss": 0, "swap": 0}
    roll = read(f"/proc/{pid}/smaps_rollup")
    if roll:
        for line in roll.splitlines():
            k, _, v = line.partition(":")
            v = v.split()
            if not v:
                continue
            if k == "Pss":
                m["pss"] = int(v[0]) * 1024
            elif k == "Rss":
                m["rss"] = int(v[0]) * 1024
            elif k == "SwapPss":
                m["swap"] = int(v[0]) * 1024
    else:
        st = read(f"/proc/{pid}/statm")
        if st:
            m["rss"] = m["pss"] = int(st.split()[1]) * PAGE
    return m


def uptime_of(start_ticks):
    up = read("/proc/uptime")
    return max(0.0, float(up.split()[0]) - start_ticks / HZ) if up else 0.0


def is_qs(argv, config):
    if not argv or os.path.basename(argv[0]) not in ("qs", "quickshell") or "ipc" in argv:
        return False
    for i, a in enumerate(argv[:-1]):
        if a in ("-c", "--config") and argv[i + 1] == config:
            return True
    return False


def thread_group(name):
    if name.startswith("QSGRender"):
        return "rendering"
    if name.startswith(("QFFmpeg", "av:", "cuda", "FFmpeg", "VideoR", "vaapi")):
        return "video decoding"
    if name.startswith("Wayland"):
        return "Wayland events"
    if name in ("qs", "quickshell"):
        return "main + QML"
    return "other"


def thread_ticks(pid):
    out = {}
    try:
        tasks = os.listdir(f"/proc/{pid}/task")
    except OSError:
        return out
    for t in tasks:
        s = stat_of(pid, t)
        if s:
            out[t] = (s["comm"], s["ticks"])
    return out


# ---------- GPU ----------
def nvidia_vram():
    if not shutil.which("nvidia-smi"):
        return None
    try:
        x = subprocess.run(["nvidia-smi", "-q", "-x"], capture_output=True, text=True, timeout=8).stdout
        root = ET.fromstring(x)
    except (subprocess.SubprocessError, ET.ParseError, OSError):
        return None
    vram = {}
    for p in root.iter("process_info"):
        try:
            pid = int(p.findtext("pid"))
            mib = int((p.findtext("used_memory") or "0").split()[0])
        except (TypeError, ValueError):
            continue
        vram[pid] = vram.get(pid, 0) + mib * 1024 * 1024
    return vram


def nvidia_summary():
    if not shutil.which("nvidia-smi"):
        return None
    try:
        r = subprocess.run(["nvidia-smi", "--query-gpu=name,utilization.gpu,memory.used,memory.total,power.draw",
                            "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=8).stdout.strip()
        name, util, used, total, power = [v.strip() for v in r.splitlines()[0].split(",")]
        return {"name": name, "busy": float(util), "vram_used": float(used) * 1048576, "vram_total": float(total) * 1048576,
                "power": float(power) if power not in ("[N/A]", "N/A", "") else None}
    except (subprocess.SubprocessError, OSError, ValueError, IndexError):
        return None


class NvidiaPmon(threading.Thread):
    """per-process GPU load (SM %), one sample a second, averaged over the run"""
    def __init__(self, seconds):
        super().__init__(daemon=True)
        self.seconds = max(1, int(round(seconds)))
        self.samples = {}

    def run(self):
        try:
            out = subprocess.run(["nvidia-smi", "pmon", "-s", "u", "-d", "1", "-c", str(self.seconds)],
                                 capture_output=True, text=True, timeout=self.seconds + 10).stdout
        except (subprocess.SubprocessError, OSError):
            return
        for line in out.splitlines():
            if line.startswith("#"):
                continue
            f = line.split()
            if len(f) < 4 or not f[1].isdigit():
                continue
            pid, sm = int(f[1]), f[3]
            self.samples.setdefault(pid, []).append(float(sm) if sm.replace(".", "", 1).isdigit() else 0.0)

    def load(self, pid):
        s = self.samples.get(pid)
        return sum(s) / len(s) if s else None


def drm_snapshot(pid):
    """AMD / Intel (and others with fdinfo): busy nanoseconds per engine and memory, per DRM client"""
    clients = {}
    try:
        fds = os.listdir(f"/proc/{pid}/fdinfo")
    except OSError:
        return clients
    for fd in fds:
        info = read(f"/proc/{pid}/fdinfo/{fd}")
        if not info or "drm-client-id" not in info:
            continue
        c = {"engines": {}, "mem": 0}
        cid = None
        for line in info.splitlines():
            k, _, v = line.partition(":")
            v = v.strip()
            if k == "drm-client-id":
                cid = v
            elif k.startswith("drm-engine-") and v.endswith("ns"):
                c["engines"][k[11:]] = int(v.split()[0])
            elif k in ("drm-memory-vram", "drm-total-vram0", "drm-total-vram", "drm-resident-local0"):
                n, unit = (v.split() + ["B"])[:2]
                c["mem"] = max(c["mem"], int(n) * {"KiB": 1024, "MiB": 1048576, "B": 1}.get(unit, 1))
        if cid:
            clients[cid] = c
    return clients


def drm_load(a, b, seconds):
    busy, mem = 0.0, 0
    for cid, cb in b.items():
        ca = a.get(cid, {"engines": {}})
        for eng, ns in cb["engines"].items():
            busy = max(busy, (ns - ca["engines"].get(eng, ns)) / (seconds * 1e9) * 100)
        mem += cb["mem"]
    return busy, mem


# ---------- sampling ----------
def identify():
    found = {"shell": [], "lock": [], "wallpaper": []}
    for pid in all_pids():
        argv = argv_of(pid)
        if is_qs(argv, "YukiShell"):
            found["shell"].append(pid)
        elif is_qs(argv, "YukiLock"):
            found["lock"].append(pid)
        else:
            s = stat_of(pid)
            if s and s["comm"] in WALLPAPER_COMMS:
                found["wallpaper"].append(pid)
    return found


def parent_map():
    m = {}
    for pid in all_pids():
        s = stat_of(pid)
        if s:
            m[pid] = s["ppid"]
    return m


def descendants(roots, pmap):
    kids = {}
    for p, pp in pmap.items():
        kids.setdefault(pp, []).append(p)
    out, todo = [], list(roots)
    while todo:
        for c in kids.get(todo.pop(), []):
            out.append(c)
            todo.append(c)
    return out


def leftovers():
    out = []
    for pid in all_pids():
        s = stat_of(pid)
        if not s:
            continue
        for comm, needle, label in LEFTOVER_SIGS:
            if s["comm"] != comm:
                continue
            parent = stat_of(s["ppid"]) if s["ppid"] > 1 else None
            orphan = s["ppid"] == 1 or (parent and parent["comm"] in ("systemd", "init"))
            if orphan and needle in " ".join(argv_of(pid)):
                out.append({"pid": pid, "what": label})
    return out


def dir_size(path):
    total = 0
    for root, _dirs, files in os.walk(path, onerror=lambda e: None):
        for f in files:
            try:
                total += os.lstat(os.path.join(root, f)).st_size
            except OSError:
                pass
    return total


def caches():
    out = []
    for base, label in ((os.path.join(CACHE, "yukishell"), "wallpaper copies, previews, glass"),
                        (os.path.join(CACHE, "yukibar"), "clipboard history, bar")):
        if not os.path.isdir(base):
            continue
        parts = []
        for e in sorted(os.scandir(base), key=lambda e: e.name):
            size = dir_size(e.path) if e.is_dir(follow_symlinks=False) else (e.stat(follow_symlinks=False).st_size)
            parts.append({"name": e.name, "bytes": size})
        parts.sort(key=lambda p: -p["bytes"])
        out.append({"path": base.replace(HOME, "~", 1), "what": label, "bytes": sum(p["bytes"] for p in parts), "parts": parts})
    return out


def lock_state():
    try:
        return subprocess.run(["qs", "-c", "YukiLock", "ipc", "call", "lockscreen", "state"], capture_output=True,
                              text=True, timeout=3).stdout.strip()
    except (subprocess.SubprocessError, OSError):
        return ""


def sample(seconds):
    found = identify()
    roots = found["shell"] + found["lock"]
    pmap = parent_map()
    helpers0 = descendants(roots, pmap)
    watched = roots + found["wallpaper"] + helpers0
    t0 = {p: stat_of(p) for p in watched}
    th0 = {p: thread_ticks(p) for p in found["shell"]}
    drm0 = {p: drm_snapshot(p) for p in watched}
    pmon = NvidiaPmon(seconds) if shutil.which("nvidia-smi") else None
    if pmon:
        pmon.start()

    # short-lived programs the shell starts while we watch (polls, one-off commands)
    known = set(pmap)
    spawned = {}
    start = time.monotonic()
    while time.monotonic() - start < seconds:
        try:
            pids = all_pids()
        except OSError:
            pids = []
        for p in pids:
            if p in known:
                continue
            known.add(p)
            chain, q = 0, p
            while chain < 12:
                s = stat_of(q)
                if not s:
                    break
                q = s["ppid"]
                if q in roots:
                    argv = argv_of(p)
                    spawned[p] = os.path.basename(argv[0]) if argv else (stat_of(p) or {}).get("comm", "?")
                    break
                if q <= 1:
                    break
                chain += 1
        time.sleep(0.02)
    elapsed = time.monotonic() - start
    if pmon:
        pmon.join(timeout=seconds + 10)

    vram = nvidia_vram()
    rows = []

    def row(pid, role, label):
        a, b = t0.get(pid), stat_of(pid)
        if not b:
            return None
        cpu = ((b["ticks"] - a["ticks"]) / HZ / elapsed * 100) if a else None
        r = {"pid": pid, "role": role, "name": label, "cpu": cpu, "threads": b["threads"], "up": uptime_of(b["start"])}
        r.update(memory_of(pid))
        gl, gm = None, None
        if vram is not None:
            gm = vram.get(pid)
            gl = pmon.load(pid) if pmon else None
        else:
            busy, mem = drm_load(drm0.get(pid, {}), drm_snapshot(pid), elapsed)
            if busy or mem:
                gl, gm = busy, mem
        r["gpu"], r["vram"] = gl, gm
        return r

    for pid in found["shell"]:
        r = row(pid, "shell", "YukiShell")
        if r:
            groups = {}
            th1 = thread_ticks(pid)
            for t, (comm, ticks) in th1.items():
                prev = th0.get(pid, {}).get(t)
                d = ticks - prev[1] if prev else 0
                g = groups.setdefault(thread_group(comm), {"cpu": 0.0, "threads": 0})
                g["cpu"] += d / HZ / elapsed * 100
                g["threads"] += 1
            r["breakdown"] = sorted(({"group": k, **v} for k, v in groups.items()), key=lambda x: -x["cpu"])
            fds = os.listdir(f"/proc/{pid}/fd") if os.path.isdir(f"/proc/{pid}/fd") else []
            r["open_files"] = len(fds)
            rows.append(r)
    lstate = lock_state() if found["lock"] else ""
    for pid in found["lock"]:
        r = row(pid, "lock", "YukiLock")
        if r:
            r["state"] = {"ready": "waiting, warmed up", "busy": "locked", "stopping": "unlocking"}.get(lstate, lstate or "running")
            rows.append(r)
    for pid in found["wallpaper"]:
        s = stat_of(pid)
        r = row(pid, "wallpaper", s["comm"] if s else "wallpaper")
        if r:
            r["state"] = WALLPAPER_COMMS.get(r["name"], "")
            rows.append(r)
    helpers = []
    for pid in helpers0:
        s = stat_of(pid)
        if not s:
            continue
        r = row(pid, "helper", s["comm"])
        if r:
            r["state"] = HELPER_NAMES.get(s["comm"], "") or (
                "input method watcher" if any(x.endswith("imwatch.py") for x in argv_of(pid)) else "")
            r["parent"] = "YukiLock" if pid in descendants(found["lock"], parent_map()) else "YukiShell"
            helpers.append(r)

    counts = {}
    for name in spawned.values():
        counts[name] = counts.get(name, 0) + 1
    everything = rows + helpers
    total = {
        "cpu": sum(r["cpu"] or 0 for r in everything),
        "pss": sum(r["pss"] for r in everything),
        "swap": sum(r["swap"] for r in everything),
        "gpu": sum(r["gpu"] or 0 for r in everything if r["gpu"] is not None),
        "vram": sum(r["vram"] or 0 for r in everything if r["vram"] is not None),
    }
    return {
        "version": version(), "seconds": round(elapsed, 2), "cpu_threads": os.cpu_count(),
        "processes": rows, "helpers": helpers,
        "launches": {"count": len(spawned), "per_minute": round(len(spawned) / elapsed * 60, 1), "by_program": counts},
        "total": total, "gpu": nvidia_summary(), "leftovers": leftovers(), "caches": caches(),
    }


# ---------- output ----------
def version():
    js = read(os.path.join(CONFIG, "Version.js")) or ""
    m = re.search(r'var\s+version\s*=\s*"([^"]+)"', js)
    return m.group(1) if m else "?"


COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def c(code, s):
    return f"\033[{code}m{s}\033[0m" if COLOR else s


def b(s):
    return c("1", s)


def dim(s):
    return c("2", s)


def pink(s):
    return c("38;2;238;172;190", s)


def size(n):
    if n is None:
        return "-"
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(n) < 1024 or unit == "TiB":
            return f"{n:.0f} {unit}" if unit in ("B", "KiB", "MiB") else f"{n:.1f} {unit}"
        n /= 1024


def pct(v):
    return "-" if v is None else f"{v:.1f}%"


def dur(s):
    s = int(s)
    d, s = divmod(s, 86400)
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    return f"{d}d{h:02d}h" if d else (f"{h}h{m:02d}m" if h else (f"{m}m{s:02d}s" if m else f"{s}s"))


def cpu_col(v):
    t = pct(v).rjust(7)
    if v is None:
        return t
    return c("31", t) if v >= 50 else (c("33", t) if v >= 15 else t)


def table_row(label, r, indent=""):
    name = (indent + label)[:36].ljust(36)
    return (f"{name} {str(r['pid']).rjust(7)} {cpu_col(r['cpu'])} {size(r['pss']).rjust(10)} {size(r['rss']).rjust(10)} "
            f"{pct(r['gpu']).rjust(6)} {size(r['vram']).rjust(9)} {dur(r['up']).rjust(8)}")


def render(d):
    out = []
    cores = d["cpu_threads"] or 1
    out.append(b(pink("YukiShell")) + b(f" v{d['version']}") + dim(f"  ·  resource usage, sampled over {d['seconds']:.1f} s  ·  {cores} CPU threads"))
    out.append("")
    head = f"{'PROCESS':36} {'PID':>7} {'CPU':>7} {'RAM':>10} {'RSS':>10} {'GPU':>6} {'VRAM':>9} {'UPTIME':>8}"
    out.append(b(head))
    if not d["processes"]:
        out.append(c("33", "YukiShell is not running."))
    for r in d["processes"]:
        label = r["name"] + (f" ({r['state']})" if r.get("state") else "")
        if r["role"] == "wallpaper":
            label = f"wallpaper: {r['name']}"
        out.append(table_row(label, r))
        if r["role"] == "shell":
            br = r.get("breakdown", [])
            for i, g in enumerate(br):
                tree = "└ " if i == len(br) - 1 else "├ "
                lbl = f"  {tree}{g['group']}" + (f" ×{g['threads']}" if g["threads"] > 1 else "")
                out.append(dim(f"{lbl[:36].ljust(36)} {'':>7} {pct(g['cpu']).rjust(7)}"))
            out.append(dim(f"  {r['threads']} threads, {r.get('open_files', 0)} open files, swap {size(r['swap'])}"))
    out.append("")

    out.append(b("HELPERS") + dim("  long-running programs the shell and the lock started"))
    if d["helpers"]:
        for r in sorted(d["helpers"], key=lambda r: r["name"]):
            lbl = r["name"] + (f" ({r['state']})" if r.get("state") else "")
            out.append(table_row(lbl, r, "  "))
    else:
        out.append(dim("  none"))
    out.append("")

    L = d["launches"]
    by = ", ".join(f"{k} ×{v}" if v > 1 else k for k, v in sorted(L["by_program"].items(), key=lambda kv: -kv[1]))
    out.append(b("BACKGROUND LAUNCHES") + dim("  short-lived programs started while sampling (polls, one-off commands)"))
    out.append(f"  {L['count']} in {d['seconds']:.1f} s (~{L['per_minute']:.0f}/min)" + (f": {by}" if by else ""))
    out.append("")

    t = d["total"]
    out.append(b("TOTAL") + "   " + "  ·  ".join([
        f"CPU {pct(t['cpu'])} of one thread ({t['cpu'] / cores:.1f}% of the whole CPU)",
        f"RAM {size(t['pss'])}" + (f" + {size(t['swap'])} swap" if t["swap"] > 0 else ""),
        f"GPU ~{t['gpu']:.0f}%",
        f"VRAM {size(t['vram'])}",
    ]))
    g = d["gpu"]
    if g:
        line = f"{g['name']}: {g['busy']:.0f}% busy, {size(g['vram_used'])} / {size(g['vram_total'])} video memory"
        if g["power"] is not None:
            line += f", {g['power']:.1f} W"
        out.append(b("GPU") + "     " + line + dim("  (the whole system)"))
    out.append("")

    out.append(b("CACHES"))
    if d["caches"]:
        for cch in d["caches"]:
            top = ", ".join(f"{p['name']} {size(p['bytes'])}" for p in cch["parts"][:4])
            out.append(f"  {cch['path'].ljust(20)} {size(cch['bytes']).rjust(10)}  " + dim(f"{cch['what']}" + (f": {top}" if top else "")))
    else:
        out.append(dim("  none"))
    out.append("")

    lf = d["leftovers"]
    if lf:
        out.append(b("LEFTOVERS") + "  " + c("33", f"{len(lf)} helper(s) left behind by an earlier YukiShell: ")
                   + ", ".join(f"{x['what']} (pid {x['pid']})" for x in lf) + dim("  (cleaned up at the next shell start)"))
    else:
        out.append(b("LEFTOVERS") + "  " + c("32", "none") + dim("  (no helpers left behind by an earlier YukiShell)"))
    return "\n".join(out)


# ---------- snapshot clean-up (yukishell sc) ----------
SC_HELP = """yukishell sc: clean up snapper snapshots

  yukishell sc                    keep the newest 4 snapshots, delete the others (asks first)
  -n, --dry-run                   only show what would be deleted
  -k, --keep N                    keep the newest N (default 4: the last two updates' before + after)
  --keep-id NUM                   also keep snapshot NUM; repeat it for more
  --limit N                       also set snapper's NUMBER_LIMIT to N (and NUMBER_LIMIT_IMPORTANT to half of it)
  -c, --config NAME               snapper config (default: root)
  -y, --yes                       don't ask before deleting

Needs root: it asks for your password through sudo. Snapshot 0 (the running system) is never touched, and a "pre" snapshot
is kept or deleted together with its "post". With grub-btrfs installed, the GRUB snapshot menu is rebuilt once afterwards,
and its rebuild service is made to wait for grub-mkconfig (the two used to write the same file at once and fail)."""

GRUB_DROPIN_DIR = "/etc/systemd/system/grub-btrfs-snapper.service.d"
GRUB_DROPIN = GRUB_DROPIN_DIR + "/wait-for-mkconfig.conf"
GRUB_DROPIN_TEXT = """[Service]
# added by `yukishell sc`: wait for the pre + post snapshots of an update, and for a running grub-mkconfig (pacman's kernel hook),
# so the two don't write /boot/grub/grub-btrfs.new at the same time
ExecStartPre=/bin/sh -c 'sleep 3; while pgrep -x grub-mkconfig >/dev/null; do sleep 1; done'
"""


def used_bytes(path="/"):
    st = os.statvfs(path)
    return (st.f_blocks - st.f_bfree) * st.f_frsize


def snapper_list(config):
    r = subprocess.run(["snapper", "--jsonout", "-c", config, "list"], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit("yukishell sc: snapper couldn't list the snapshots: " + (r.stderr.strip() or r.stdout.strip()))
    data = json.loads(r.stdout)
    snaps = data.get(config) or next(iter(data.values()), [])
    return [x for x in snaps if int(x.get("number", 0)) != 0]


def plan_cleanup(snaps, keep, keep_ids):
    """-> set of snapshot numbers to keep: the newest `keep`, the asked ids, and the pre/post partner of anything kept"""
    nums = sorted(int(x["number"]) for x in snaps)
    kept = set(nums[-keep:] if keep > 0 else []) | (set(keep_ids) & set(nums))
    pre_of = {int(x["number"]): int(x["pre-number"]) for x in snaps if x.get("type") == "post" and x.get("pre-number")}
    post_of = {v: k for k, v in pre_of.items()}
    for n in list(kept):
        if n in pre_of: kept.add(pre_of[n])
        if n in post_of: kept.add(post_of[n])
    return kept


def grub_btrfs_installed():
    return os.path.exists("/etc/grub.d/41_snapshots-btrfs") and \
        subprocess.run(["systemctl", "cat", "grub-btrfs-snapper.service"], capture_output=True).returncode == 0


def rebuild_grub_menu():
    if not os.path.exists(GRUB_DROPIN):
        os.makedirs(GRUB_DROPIN_DIR, exist_ok=True)
        with open(GRUB_DROPIN, "w") as f:
            f.write(GRUB_DROPIN_TEXT)
        subprocess.run(["systemctl", "daemon-reload"])
        print("  " + dim("grub-btrfs-snapper now waits for grub-mkconfig (" + GRUB_DROPIN + ")"))
    for _ in range(60):          # a rebuild the deletions started: let it finish first
        if subprocess.run(["systemctl", "is-active", "-q", "grub-btrfs-snapper.service"]).returncode != 0:
            break
        time.sleep(1)
    try:
        os.remove("/boot/grub/grub-btrfs.new")
    except OSError:
        pass
    subprocess.run(["systemctl", "start", "grub-btrfs-snapper.service"])
    cfg = "/boot/grub/grub-btrfs.cfg"
    ok = not os.path.exists("/boot/grub/grub-btrfs.new") and \
        subprocess.run(["grub-script-check", cfg], capture_output=True).returncode == 0
    if ok:
        n = sum(1 for line in open(cfg, errors="replace") if line.startswith("submenu"))
        print("  " + c("32", "GRUB snapshot menu rebuilt") + dim(f" ({n} snapshot entr{'y' if n == 1 else 'ies'})"))
    else:
        print("  " + c("33", "the GRUB snapshot menu didn't rebuild cleanly") + dim(" (the normal boot menu is fine)"))


def cmd_sc(args):
    keep, keep_ids, limit, config, dry, yes = 4, [], None, "root", False, False
    it = iter(args)
    try:
        for a in it:
            if a in ("-n", "--dry-run"): dry = True
            elif a in ("-y", "--yes"): yes = True
            elif a in ("-k", "--keep"): keep = max(0, int(next(it)))
            elif a == "--keep-id": keep_ids.append(int(next(it)))
            elif a == "--limit": limit = max(1, int(next(it)))
            elif a in ("-c", "--config"): config = next(it)
            elif a in ("-h", "--help"): print(SC_HELP); return
            else: sys.exit(f"yukishell sc: unknown option {a!r} (see yukishell sc --help)")
    except (StopIteration, ValueError):
        sys.exit("yukishell sc: that option needs a number (see yukishell sc --help)")
    if not shutil.which("snapper"):
        sys.exit("yukishell sc: snapper isn't installed, so there are no snapper snapshots to clean")
    if os.geteuid() != 0:
        print(dim("snapper needs root: asking sudo…"))
        os.execvp("sudo", ["sudo", sys.executable, os.path.realpath(__file__), "sc"] + list(args))

    snaps = snapper_list(config)
    if not snaps:
        print("No snapshots in snapper's " + b(config) + " config.")
        return
    kept = plan_cleanup(snaps, keep, keep_ids)
    gone = [x for x in snaps if int(x["number"]) not in kept]
    print(b("SNAPSHOTS") + dim(f"  ({config}: {len(snaps)}, keeping {len(snaps) - len(gone)})"))
    for x in sorted(snaps, key=lambda x: int(x["number"])):
        n = int(x["number"]); k = n in kept
        mark = c("32", "keep  ") if k else c("31", "delete")
        desc = (x.get("description") or "").strip() or dim("(no description)")
        typ = x.get("type", "")
        typ = typ + (f" of {x['pre-number']}" if typ == "post" and x.get("pre-number") else "")
        print(f"  {mark}  {str(n).rjust(5)}  {str(x.get('date', ''))[:16].ljust(16)}  {typ.ljust(12)}  {desc[:70]}")
    if not gone:
        print(c("32", "Nothing to delete."))
    elif dry:
        print(dim(f"Dry run: {len(gone)} snapshot(s) would be deleted. Run it without -n to do it."))
    else:
        if not yes:
            try:
                ans = input(f"Delete {len(gone)} snapshot(s)? [y/N] ").strip().lower()
            except EOFError:
                ans = ""
            if ans not in ("y", "yes"):
                print("Nothing deleted.")
                return
        before = used_bytes("/")
        nums = [str(x["number"]) for x in gone]
        r = subprocess.run(["snapper", "-c", config, "delete", "--sync"] + nums)
        if r.returncode != 0:
            sys.exit("yukishell sc: snapper delete failed (see above); nothing else was changed")
        freed = before - used_bytes("/")
        print("  " + c("32", f"deleted {len(gone)} snapshot(s)") + dim(f", about {size(max(0, freed))} freed (btrfs may keep releasing space for a minute)"))
        if grub_btrfs_installed():
            rebuild_grub_menu()
    if limit is not None and not dry:
        r = subprocess.run(["snapper", "-c", config, "set-config", f"NUMBER_LIMIT={limit}", f"NUMBER_LIMIT_IMPORTANT={max(1, limit // 2)}"])
        print("  " + (c("32", f"snapper keeps at most {limit} from now on") if r.returncode == 0 else c("31", "setting the limit failed")))


# ---------- commands ----------
def cmd_stats(args):
    seconds, watch, as_json = 2.0, False, False
    it = iter(args)
    for a in it:
        if a in ("-i", "--interval"):
            try:
                seconds = max(0.5, min(60.0, float(next(it))))
            except (StopIteration, ValueError):
                sys.exit("yukishell stats: -i needs a number of seconds")
        elif a in ("-w", "--watch"):
            watch = True
        elif a == "--json":
            as_json = True
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return
        else:
            sys.exit(f"yukishell stats: unknown option {a!r} (see yukishell help)")
    if as_json:
        print(json.dumps(sample(seconds), indent=2))
        return
    if not watch:
        if sys.stdout.isatty():
            print(dim(f"sampling for {seconds:g} s…"), end="\r", flush=True)
        text = render(sample(seconds))
        print("\033[2K" + text if sys.stdout.isatty() else text)
        return
    try:
        while True:
            text = render(sample(seconds))
            print("\033[H\033[2J" + text + "\n" + dim("refreshing every ~%g s · Ctrl+C to stop" % seconds), flush=True)
    except KeyboardInterrupt:
        print()


def main(argv):
    if not argv or argv[0] in ("help", "-h", "--help"):
        print(__doc__.strip())
        return
    cmd, rest = argv[0], argv[1:]
    if cmd == "stats":
        cmd_stats(rest)
    elif cmd in ("sc", "snapshots"):
        cmd_sc(rest)
    elif cmd in ("version", "--version", "-v"):
        print(f"YukiShell v{version()}")
    else:
        sys.exit(f"yukishell: unknown command {cmd!r} (try: yukishell stats, yukishell sc, yukishell help)")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except BrokenPipeError:
        pass
