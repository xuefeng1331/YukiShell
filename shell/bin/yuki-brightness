#!/usr/bin/env bash
rt="${XDG_RUNTIME_DIR:-/tmp}"; cache="$rt/yuki-brightness.val"; busf="$rt/yuki-brightness.bus"; lock="$rt/yuki-brightness.lock"

backlight() {
    local d; for d in /sys/class/backlight/*/; do [ -e "${d}brightness" ] && { brightnessctl -c backlight -m 2>/dev/null | head -n1; return; }; done
}
bus() {
    [ -s "$busf" ] || ddcutil detect --brief 2>/dev/null | sed -n 's#.*I2C bus: */dev/i2c-\([0-9]*\).*#\1#p' | head -n1 > "$busf"
    cat "$busf"
}
fresh() { [ -s "$cache" ] && [ $(( $(date +%s) - $(stat -c %Y "$cache") )) -lt 30 ]; }

get() {
    if [ -n "$(backlight)" ]; then backlight | cut -d, -f4 | tr -d %; return; fi
    if fresh; then cat "$cache"; return; fi
    local b; b=$(bus); [ -n "$b" ] || return 1
    ddcutil --bus "$b" getvcp 10 --brief 2>/dev/null | awk '$1=="VCP" && $3=="C" { print $4; exit }' | tee "$cache"
}
set_() {
    local p=$1; [ "$p" -lt 1 ] && p=1; [ "$p" -gt 100 ] && p=100
    if [ -n "$(backlight)" ]; then brightnessctl -c backlight -q set "${p}%"; return; fi
    echo "$p" > "$cache"
    local b; b=$(bus); [ -n "$b" ] || return 1
    flock "$lock" sh -c 'ddcutil --bus "$1" --noverify --skip-ddc-checks --sleep-multiplier 0.1 setvcp 10 "$2" || ddcutil --bus "$1" --noverify setvcp 10 "$2"' _ "$b" "$p" >/dev/null 2>&1
}

sync_() {
    local p=$1; [ "$p" -lt 1 ] && p=1; [ "$p" -gt 100 ] && p=100
    if [ -n "$(backlight)" ]; then return 0; fi
    local b; b=$(bus); [ -n "$b" ] || return 1
    exec 9>"$lock"; flock 9
    local cur="" i
    for i in 1 2 3 4; do
        cur=$(ddcutil --bus "$b" getvcp 10 --brief 2>/dev/null | awk '$1=="VCP" && $3=="C" { print $4; exit }')
        [ "$cur" = "$p" ] && break
        ddcutil --bus "$b" --sleep-multiplier 0.5 setvcp 10 "$p" >/dev/null 2>&1
        sleep 0.12
    done
    [ -n "$cur" ] && echo "$cur" > "$cache"
    [ "$cur" = "$p" ]
}

case "${1:-get}" in
    get)  get ;;
    getm) v=$(get) && echo "yuki,monitor,$v,${v}%" ;;
    set)  set_ "$2" ;;
    sync) sync_ "$2" ;;
    step) cur=$(get) || exit 1; set_ $(( cur + $2 )) ;;
    *)    echo "usage: yuki-brightness get|set N|sync N|step +N|-N" >&2; exit 2 ;;
esac
