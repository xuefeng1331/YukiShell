#!/bin/sh
# yuki-greeter-sync: what the login screen (shell/YukiLock/greeter.qml) shows: who signs in, their picture, wallpaper, clock,
# keyboard layout and the session they picked last. The login screen runs as greetd's "greeter" user and can't read your home,
# so this copies them to /var/lib/yukigreet, a folder install.sh makes yours (other accounts get their own folder in its
# users/). yuki-start runs it at every login and the wallpaper script when the wallpaper changes (with the new picture as $1).
r="${YUKIGREET_DIR:-/var/lib/yukigreet}"
command -v jq >/dev/null || exit 0
me=$(id -un)
if [ "$(stat -c %U "$r" 2>/dev/null)" = "$me" ]; then d=$r
elif [ -d "$r/users" ] && [ -w "$r/users" ]; then
    d="$r/users/$me"
    # a folder under your name that someone else made is not yours to fill (the login screen ignores it too)
    mkdir -p "$d" 2>/dev/null; [ "$(stat -c %U "$d" 2>/dev/null)" = "$me" ] || exit 0
    chmod 755 "$d"
else exit 0
fi
[ -w "$d" ] || exit 0
s="${XDG_CONFIG_HOME:-$HOME/.config}/yukibar/settings.json"
put() { [ -f "$1" ] || return 1; cmp -s "$1" "$d/$2" || cp -f "$1" "$d/$2"; chmod 644 "$d/$2"; }

wall=$(jq -r '.lockWallpaper // empty' "$s" 2>/dev/null)
[ -f "$wall" ] || wall=$1
[ -f "$wall" ] || wall=$(jq -r '.wallpaperPath // empty' "$s" 2>/dev/null)
[ -f "$wall" ] || wall=$(awww query 2>/dev/null | sed -n 's/.*image: //p' | head -n1)
w=; put "$wall" wallpaper && w=wallpaper
a=; for f in "$HOME/.face" "$HOME/.face.icon" "/var/lib/AccountsService/icons/$me"; do put "$f" avatar && { a=avatar; break; }; done
name=$(getent passwd "$me" | cut -d: -f5 | cut -d, -f1)
# the keyboard layout you type in (so the password is typed on the same one), and the session the login screen started
# (it passes its id as YUKI_SESSION; anything else keeps the last one)
kb=$(hyprctl getoption input:kb_layout -j 2>/dev/null | jq -r '.str // empty' 2>/dev/null)
kv=$(hyprctl getoption input:kb_variant -j 2>/dev/null | jq -r '.str // empty' 2>/dev/null)
[ "$kv" = "[[EMPTY]]" ] && kv=
sess=$(printf '%s' "${YUKI_SESSION:-}" | tr -cd 'A-Za-z0-9._@+-')
[ -n "$sess" ] || sess=$(jq -r '.session // empty | strings' "$d/profile.json" 2>/dev/null)

{ cat "$s" 2>/dev/null || echo '{}'; } | jq --arg user "$me" --arg name "${name:-$me}" --arg a "$a" --arg w "$w" --arg kb "$kb" --arg kv "$kv" --arg sess "$sess" '{
    user: $user, name: $name, avatar: $a, wallpaper: $w, kb: { layout: $kb, variant: $kv }, session: $sess,
    use24h: (.use24h != false), artBg: (.lockArtBackground != false), language: (.language // "auto"),
    clock: { f: .lockClockFont, w: .lockClockWeight, m: .lockClockMaterial, d: .lockClockDate, i: .lockClockIntensity, c: .lockClockTint },
    glass: { o: .glassOpacity, r: .glassRim, l: .glassLiquid, s: .barStyle }
}' > "$d/profile.json.tmp" && chmod 644 "$d/profile.json.tmp" && mv -f "$d/profile.json.tmp" "$d/profile.json"
